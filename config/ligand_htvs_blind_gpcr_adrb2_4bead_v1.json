{
  "version": "ligand_htvs_blind_gpcr_adrb2_4bead_v1",
  "description": "4-bead ONSPS cascade blind gate for ADRB2. Extends scorefix3 with two-pass 4-bead+topo scoring and H-bond proxy regression thresholds.",
  "targets": "ADRB2_GPCR_BLIND",
  "run_scope": "full",
  "trajectory_engine_mode": "rust_hip",
  "require_rust_hip": true,
  "stage3_ligand_model": "auto",
  "stage3_onsps_4bead_cascade": true,
  "stage3_two_pass_scoring": true,
  "stage3_two_pass_topk_pct": 0.05,
  "stage3_residual_assist_mode": "assist",
  "stage3_hbond_onsps_weight": 1.0,
  "stage2_skip_router_enabled": true,
  "traj_multi_start_count": 3,
  "traj_pocket_protein_max_atoms": 256,
  "target_native_csv": "config/real_drug_targets_blind_gpcr_adrb2_v1.csv",
  "native_path_col": "native_pdb_path",
  "ligand_csv": "config/ligand_binding_reference_blind_gpcr_adrb2_v1.csv",
  "csv_relax_3d": true,
  "stage3_min_frames": 100,
  "stage3_score_only": true,
  "ranking_score_col": "binding_score_composite_v7",
  "ranking_eval_roles": "far_ood_eval",
  "require_split_for_ranking": true,
  "gate": {
    "enforce_operational_gate": true,
    "strict_fail_fast": true,
    "min_frames": 100,
    "ranking_auc_min": 0.85,
    "pr_auc_min": 0.55,
    "roc_auc_ci_lower_min": 0.75,
    "topk_k": 20,
    "topk_hit_rate_min": 0.2,
    "four_bead_cascade_enabled": true,
    "four_bead_delta_backmap_max": 2.5,
    "four_bead_topo_correction_delta_max": 1.0,
    "four_bead_no_pass_to_fail_vs_2bead": true,
    "onsps_hbond_angle_score_min": 0.0
  }
}
