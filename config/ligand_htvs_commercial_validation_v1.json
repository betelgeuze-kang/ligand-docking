{
  "version": "ligand_htvs_commercial_validation_v1",
  "description": "Commercial-grade ligand validation profile with leakage audit, hard-decoy curation and CI-aware gates.",
  "targets": "KRAS_G12D,EGFR_KINASE,HIV1_PROTEASE",
  "run_scope": "full",
  "trajectory_engine_mode": "rust_hip",
  "require_rust_hip": true,
  "traj_dynamic_core_fallback_on_oom": false,
  "traj_abort_on_runtime_error": true,
  "traj_abort_on_cpu_backend": true,
  "dry_run": false,
  "smoke": {
    "max_ligands": 64,
    "replicas": 64,
    "jobs_per_target": 64,
    "traj_frames": 100,
    "max_jobs_score": 640
  },
  "full": {
    "max_ligands": 10000,
    "replicas": 128,
    "jobs_per_target": 10000,
    "traj_frames": 120,
    "max_jobs_score": 10000
  },
  "stage3_min_frames": 100,
  "calibration_reference_csv": "config/ligand_binding_reference_expanded_v2.csv",
  "ranking_labels_csv": "config/ligand_binding_reference_expanded_v2.csv",
  "eval_split_csv": "config/ligand_eval_splits_v1.csv",
  "calibration_fit_roles": "fit",
  "ranking_eval_roles": "id_eval,near_ood_eval,eval",
  "ranking_ood_eval_roles": "far_ood_eval,ood_eval",
  "require_split_for_calibration": true,
  "require_split_for_ranking": true,
  "require_ood_eval": true,
  "enforce_zero_overlap": true,
  "run_leakage_audit": true,
  "leakage_fit_roles": "fit",
  "leakage_eval_roles": "id_eval,near_ood_eval,far_ood_eval,eval,ood_eval",
  "leakage_target_meta_csv": "config/ligand_target_metadata_v1.csv",
  "leakage_ligand_meta_csv": "config/ligand_meta_expanded_v1.csv",
  "leakage_max_key_overlap": 0,
  "leakage_max_target_overlap": 1,
  "leakage_max_family_overlap_ratio": 1.0,
  "leakage_max_scaffold_overlap_ratio": 1.0,
  "leakage_max_allowed_seq_identity": 1.0,
  "leakage_max_allowed_pocket_jaccard": 1.0,
  "build_hard_decoy_benchmark": true,
  "hard_decoy_reference_csv": "config/ligand_binding_reference_expanded_v2.csv",
  "hard_decoy_ligand_meta_csv": "config/ligand_meta_expanded_v1.csv",
  "hard_decoy_target_meta_csv": "config/ligand_target_metadata_v1.csv",
  "hard_decoy_fit_targets": "EGFR_KINASE",
  "hard_decoy_quantile": 0.5,
  "hard_decoy_min_per_target": 1,
  "hard_decoy_max_per_target": 0,
  "ranking_bootstrap_n": 800,
  "ranking_bootstrap_seed": 17,
  "ranking_bootstrap_bedroc_alpha": 20.0,
  "ranking_ece_bins": 10,
  "ranking_probability_logit_scale": 1.4,
  "positive_count_sweep": "",
  "positive_counter_auto_augment": false,
  "positive_counter_eval_roles": "id_eval,near_ood_eval,eval,far_ood_eval,ood_eval",
  "gate": {
    "enforce_operational_gate": true,
    "strict_fail_fast": true,
    "min_frames": 100,
    "max_mean_min_distance_A": 2.5,
    "ranking_auc_min": 0.85,
    "ranking_unique_auc_min": 0.85,
    "ranking_ood_auc_min": 0.80,
    "pr_auc_min": 0.55,
    "ef1_min": 1.20,
    "bedroc_min": 0.25,
    "brier_max": 0.30,
    "ece_max": 0.30,
    "roc_auc_ci_lower_min": 0.75,
    "pr_auc_ci_lower_min": 0.45,
    "ef1_ci_lower_min": 1.00,
    "topk_k": 20,
    "topk_hit_rate_min": 0.20,
    "min_positive_count": 0,
    "min_ood_positive_count": 0
  },
  "retry": {
    "max_attempts": 1,
    "sleep_sec": 5
  }
}
