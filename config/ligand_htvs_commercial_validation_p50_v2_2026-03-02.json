{
  "version": "ligand_htvs_commercial_validation_p50_v2_2026-03-02",
  "description": "P50-first commercial validation profile with role-coverage rebalance and stricter eval-key gates.",
  "targets": "KRAS_G12D,EGFR_KINASE,HIV1_PROTEASE",
  "run_scope": "full",
  "enforce_full_score_coverage": true,
  "trajectory_engine_mode": "rust_hip",
  "require_rust_hip": true,
  "traj_dynamic_core_fallback_on_oom": false,
  "traj_abort_on_runtime_error": true,
  "traj_abort_on_cpu_backend": true,
  "traj_write_every": 1,
  "traj_frame_output_format": "npz_bundle",
  "dry_run": false,
  "smoke": {
    "max_ligands": 64,
    "replicas": 64,
    "jobs_per_target": 64,
    "traj_frames": 100,
    "max_jobs_score": 640
  },
  "full": {
    "max_ligands": 10000,
    "replicas": 128,
    "jobs_per_target": 10000,
    "traj_frames": 120,
    "max_jobs_score": 0
  },
  "stage3_min_frames": 100,
  "stage3_workers": 1,
  "calibration_reference_csv": "config/ligand_binding_reference_expanded_v2.csv",
  "ranking_labels_csv": "config/ligand_binding_reference_expanded_v2.csv",
  "eval_split_csv": "config/ligand_eval_splits_v1.csv",
  "run_calibration": false,
  "ranking_score_col": "binding_score_composite_v3",
  "ranking_probability_score_col": "binding_score_composite_v3",
  "calibration_fit_roles": "fit",
  "ranking_eval_roles": "id_eval,near_ood_eval,eval",
  "ranking_ood_eval_roles": "far_ood_eval,ood_eval",
  "require_split_for_calibration": false,
  "require_split_for_ranking": true,
  "require_ood_eval": true,
  "enforce_zero_overlap": true,
  "stage45_min_observed_eval_coverage_ratio": 0.0,
  "stage45_min_observed_eval_positive_coverage_ratio": 0.0,
  "run_leakage_audit": true,
  "leakage_fit_roles": "fit",
  "leakage_eval_roles": "id_eval,near_ood_eval,far_ood_eval,eval,ood_eval",
  "leakage_target_meta_csv": "config/ligand_target_metadata_v1.csv",
  "leakage_ligand_meta_csv": "config/ligand_meta_expanded_v1.csv",
  "leakage_max_key_overlap": 0,
  "leakage_max_target_overlap": 1,
  "leakage_max_family_overlap_ratio": 1.0,
  "leakage_max_scaffold_overlap_ratio": 1.0,
  "leakage_max_allowed_seq_identity": 1.0,
  "leakage_max_allowed_pocket_jaccard": 1.0,
  "build_hard_decoy_benchmark": true,
  "hard_decoy_reference_csv": "config/ligand_binding_reference_expanded_v2.csv",
  "hard_decoy_ligand_meta_csv": "config/ligand_meta_expanded_v1.csv",
  "hard_decoy_target_meta_csv": "config/ligand_target_metadata_v1.csv",
  "hard_decoy_fit_targets": "EGFR_KINASE",
  "hard_decoy_quantile": 0.5,
  "hard_decoy_min_per_target": 1,
  "hard_decoy_max_per_target": 0,
  "ranking_bootstrap_n": 800,
  "ranking_bootstrap_seed": 17,
  "ranking_bootstrap_bedroc_alpha": 20.0,
  "ranking_ece_bins": 10,
  "ranking_probability_logit_scale": 1.4,
  "positive_count_sweep": "50",
  "positive_counter_auto_augment": true,
  "positive_counter_eval_roles": "id_eval,near_ood_eval,eval",
  "gate": {
    "enforce_operational_gate": true,
    "strict_fail_fast": true,
    "min_frames": 100,
    "max_mean_min_distance_A": 2.75,
    "mean_min_distance_source": "eval_unique_topk",
    "mean_min_distance_topk": 200,
    "ranking_auc_min": 0.85,
    "ranking_unique_auc_min": 0.85,
    "ranking_ood_auc_min": 0.8,
    "pr_auc_min": 0.55,
    "ef1_min": 1.2,
    "bedroc_min": 0.25,
    "brier_max": 0.3,
    "ece_max": 0.3,
    "roc_auc_ci_lower_min": 0.75,
    "pr_auc_ci_lower_min": 0.45,
    "ef1_ci_lower_min": 1.0,
    "topk_k": 20,
    "topk_hit_rate_min": 0.2,
    "min_positive_count": 0,
    "min_ood_positive_count": 0,
    "min_eval_unique_keys": 200,
    "min_ood_unique_keys": 200
  },
  "retry": {
    "max_attempts": 3,
    "sleep_sec": 20,
    "backoff": 1.5
  },
  "hard_decoy_synthesize_unique_decoys": true,
  "hard_decoy_synth_total_decoys": 10000,
  "hard_decoy_synth_decoys_per_target": 0,
  "hard_decoy_synth_keep_all_decoys": true,
  "hard_decoy_synth_allow_shortfall": false,
  "hard_decoy_synth_relax_3d": true,
  "hard_decoy_synth_relax_max_iters": 200,
  "hard_decoy_min_rows_per_role": 30,
  "hard_decoy_ensure_roles": "fit,id_eval,near_ood_eval,eval,far_ood_eval,ood_eval",
  "hard_decoy_rebalance_donor_roles": "id_eval,near_ood_eval,eval,far_ood_eval,ood_eval",
  "calibration_min_fit_unique_keys": 0,
  "calibration_min_pairs_to_fit": 0,
  "stage45_min_observed_fit_coverage_ratio": 0.0
}
