[Unit]
Description=Ligand HTVS Nightly Strict Batch
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/분자동역학
ExecStart=/usr/bin/bash -lc 'cd "$HOME/분자동역학" && ./tools/run_ligand_htvs_nightly.sh $(date +%%F)'
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
