FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BETELGEUZE_REPO_ROOT=/app \
    PRODUCT_API_AUTH_REQUIRED=1 \
    API_VALIDATED_RUNNER_ENABLED=0 \
    PRODUCT_API_MAX_PAYLOAD_BYTES=10485760 \
    PRODUCT_API_RATE_LIMIT_PER_MINUTE=120

WORKDIR /app
COPY requirements-package.txt requirements-api.txt requirements-deploy.txt pyproject.toml ./
COPY api ./api
COPY core ./core
COPY betelgeuze_product ./betelgeuze_product
COPY betelgeuze_cameo ./betelgeuze_cameo
COPY betelgeuze_cleanup ./betelgeuze_cleanup
COPY tools ./tools
COPY config ./config
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir . \
    && python -m pip install --no-cache-dir -r requirements-api.txt -r requirements-deploy.txt

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
