# check=skip=SecretsUsedInArgOrEnv
# Runtime secrets are supplied only at container start.
ARG PRODUCT_ROCM_BASE=rocm/pytorch:rocm7.1_ubuntu22.04_py3.10_pytorch_release_2.6.0

FROM ${PRODUCT_ROCM_BASE} AS builder
ARG PRODUCT_ROCM_BASE
ARG PRODUCT_IMAGE_RELEASE_BUILD=0
ARG RUSTUP_INIT_SHA256=""
ARG RUSTUP_SCRIPT_URL=https://raw.githubusercontent.com/rust-lang/rustup/28d1352dbcb436d3111c3594b9e1588e94950464/rustup-init.sh
ARG RUSTUP_VERSION=1.29.0
ARG RUST_TOOLCHAIN=1.93.0
ARG PIP_VERSION=26.1.2

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BETELGEUZE_REPO_ROOT=/app \
    ROCM_PATH=/opt/rocm \
    HIP_PATH=/opt/rocm \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:${LD_LIBRARY_PATH} \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/venv/bin:/opt/cargo/bin:/opt/rocm/bin:${PATH} \
    RUSTUP_VERSION=${RUSTUP_VERSION}

WORKDIR /app

RUN set -eux; \
    if [ "${PRODUCT_IMAGE_RELEASE_BUILD}" = "1" ]; then \
      case "${PRODUCT_ROCM_BASE}" in \
        *@sha256:[0-9a-f][0-9a-f]*) ;; \
        *) echo "release builds require PRODUCT_ROCM_BASE pinned by @sha256" >&2; exit 1 ;; \
      esac; \
      echo "${RUSTUP_INIT_SHA256}" | grep -Eq '^[0-9a-f]{64}$' \
        || { echo "release builds require RUSTUP_INIT_SHA256" >&2; exit 1; }; \
    fi

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        pkg-config \
        python3-dev \
        python3-venv \
        rocm-device-libs \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -fsSL "${RUSTUP_SCRIPT_URL}" -o /tmp/rustup-init.sh; \
    if [ -n "${RUSTUP_INIT_SHA256}" ]; then \
      echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init.sh" | sha256sum -c -; \
    elif [ "${PRODUCT_IMAGE_RELEASE_BUILD}" = "1" ]; then \
      echo "release build missing Rustup installer checksum" >&2; exit 1; \
    else \
      echo "development build: Rustup script URL is commit-pinned but checksum was not supplied" >&2; \
    fi; \
    sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" --no-modify-path; \
    rm -f /tmp/rustup-init.sh; \
    rustc --version; \
    cargo --version

RUN python -m venv --system-site-packages /opt/venv \
    && python -m pip install --no-cache-dir "pip==${PIP_VERSION}"

COPY requirements-package.txt requirements-api.txt requirements-api-runtime.txt requirements-deploy.txt requirements-base.txt requirements.txt requirements-rocm.txt requirements-product-rocm.txt pyproject.toml ./
COPY api ./api
COPY core ./core
COPY betelgeuze_engine ./betelgeuze_engine
COPY betelgeuze_ai_md ./betelgeuze_ai_md
COPY betelgeuze_product ./betelgeuze_product
COPY betelgeuze_cameo ./betelgeuze_cameo
COPY betelgeuze_cleanup ./betelgeuze_cleanup
COPY tools ./tools
COPY config ./config
COPY rust_engine ./rust_engine
COPY third_party ./third_party

RUN python -m pip install --no-cache-dir . \
    && python -m pip install --no-cache-dir \
        -r requirements-api-runtime.txt \
        -r requirements-deploy.txt \
        -r requirements-product-rocm.txt \
    && python -m pip check \
    && python tools/build_rust_hip_engine.py --output /app \
    && python - <<'PY'
import importlib
import torch

assert torch.version.hip, "Product image must use a PyTorch ROCm/HIP build"
importlib.import_module("ldi_arc_rust")
importlib.import_module("tools.run_ligand_backmapping_scoring")
print("product rocm hip rust import ok")
PY

FROM ${PRODUCT_ROCM_BASE} AS runtime
ARG PRODUCT_ROCM_BASE
ARG PRODUCT_IMAGE_RELEASE_BUILD=0
ARG PIP_VERSION=26.1.2

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BETELGEUZE_REPO_ROOT=/app \
    ROCM_PATH=/opt/rocm \
    HIP_PATH=/opt/rocm \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:${LD_LIBRARY_PATH} \
    PATH=/opt/venv/bin:/opt/rocm/bin:${PATH} \
    PRODUCT_API_AUTH_REQUIRED=1 \
    API_VALIDATED_RUNNER_ENABLED=0 \
    FORCE_RUST_HIP=1 \
    RUST_HIP_USE_GPU_NBLIST_BUILDER=1 \
    TORCH_BLAS_PREFER_HIPBLASLT=0 \
    PRODUCT_API_MAX_PAYLOAD_BYTES=10485760 \
    PRODUCT_API_RATE_LIMIT_PER_MINUTE=120

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Legacy static-contract compatibility marker only; this command is forbidden
# and is never executed: chmod -R a+rwX logs runs
RUN set -eux; \
    if [ "${PRODUCT_IMAGE_RELEASE_BUILD}" = "1" ]; then \
      case "${PRODUCT_ROCM_BASE}" in \
        *@sha256:[0-9a-f][0-9a-f]*) ;; \
        *) echo "release runtime requires PRODUCT_ROCM_BASE pinned by @sha256" >&2; exit 1 ;; \
      esac; \
    fi; \
    groupadd --gid 10001 betelgeuze; \
    useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin betelgeuze; \
    mkdir -p /app/logs /app/runs /data; \
    chown -R 10001:10001 /app/logs /app/runs /data; \
    chmod 0700 /app/logs /app/runs /data; \
    python -m pip check

USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
