# Copy to deploy/docker-compose.product.env and adjust secrets before:
#   docker compose --env-file deploy/docker-compose.product.env -f deploy/docker-compose.product.yml up -d
#
# Tier α runtime unlock: set API_VALIDATED_RUNNER_ENABLED=1 after reviewing runner profiles.

API_PORT=8000
PRODUCT_API_TOKEN=replace-with-operator-managed-token
PRODUCT_API_MAX_PAYLOAD_BYTES=10485760
PRODUCT_API_RATE_LIMIT_PER_MINUTE=120
PRODUCT_API_TENANT_DAILY_QUOTA=5000
PRODUCT_API_AUDIT_RETENTION_DAYS=90
PRODUCT_API_SECRET_ROTATION_DAYS=30
PRODUCT_API_PAGER_WEBHOOK_CONFIGURED=0
PRODUCT_API_HOSTED_EXPOSURE_APPROVED=0
PRODUCT_API_TLS_TERMINATION_OPERATOR_VERIFIED=1

# Tier α: enable validated runner dispatch (api-server, api-worker, api-docking-dispatch)
API_VALIDATED_RUNNER_ENABLED=1
API_VALIDATED_RUNNER_PROFILES_PATH=/app/config/api_validated_runner_profiles
API_VALIDATED_RUNNER_TIMEOUT_SECONDS=3600

API_WORKER_LEASE_SECONDS=300
API_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
API_DOCKING_DISPATCH_POLL_INTERVAL_SECONDS=2
API_DOCKING_DISPATCH_LIMIT=1

API_RESULT_MANIFEST_SIGNING_KEY=replace-with-operator-managed-secret
API_RESULT_MANIFEST_KEY_ID=product-local-tier-alpha

# Hosted/on-prem operations profile:
# - keep PRODUCT_API_HOSTED_EXPOSURE_APPROVED=0 until auth token, signing key, TLS termination,
#   backup/restore procedure, pager route, and audit retention are operator verified.
# - set PRODUCT_API_PAGER_WEBHOOK_CONFIGURED=1 only after alert delivery smoke passes against
#   the operator-managed pager endpoint.
