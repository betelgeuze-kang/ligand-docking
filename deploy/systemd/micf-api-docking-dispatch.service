[Unit]
Description=MICF API Docking Ledger Dispatch Worker
After=network-online.target micf-api-worker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/micf
EnvironmentFile=/etc/micf/api-docking-dispatch.env
ExecStart=/usr/bin/python3 /opt/micf/tools/run_api_docking_dispatch_worker.py --poll-interval-seconds ${API_DOCKING_DISPATCH_POLL_INTERVAL_SECONDS}
Restart=always
RestartSec=5
User=micf
Group=micf
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/micf

[Install]
WantedBy=multi-user.target
