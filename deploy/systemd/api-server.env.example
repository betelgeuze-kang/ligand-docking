PRODUCT_API_AUTH_REQUIRED=1
PRODUCT_API_TOKEN=replace-with-operator-managed-token
PRODUCT_API_MAX_PAYLOAD_BYTES=10485760
PRODUCT_API_RATE_LIMIT_PER_MINUTE=120
PRODUCT_API_AUDIT_LOG_PATH=/var/lib/micf/product_audit_log.jsonl
PRODUCT_API_HOSTED_EXPOSURE_APPROVED=0
PRODUCT_API_TLS_TERMINATION_OPERATOR_VERIFIED=0
API_HOST=0.0.0.0
API_PORT=8000
API_INLINE_WORKER_ENABLED=0
API_JOB_STORE_PATH=/var/lib/micf/api_jobs.sqlite3
API_VALIDATED_RUNNER_ENABLED=0
API_VALIDATED_RUNNER_NAMESPACE_RECEIPT_PATH=
API_VALIDATED_RUNNER_NAMESPACE_RECEIPT_SHA256=
API_VALIDATED_RUNNER_PROFILES_PATH=/opt/micf/config/api_validated_runner_profiles
API_VALIDATED_RUNNER_TIMEOUT_SECONDS=3600
API_RESULT_MANIFEST_SIGNING_KEY=replace-with-operator-managed-secret
API_RESULT_MANIFEST_KEY_ID=site-local-v1
DOCKING_PRIVATE_PAYLOAD_KEYS=replace-with-operator-managed-private-payload-keyring
DOCKING_PRIVATE_PAYLOAD_DIR=/var/lib/micf/private_payloads
RESULTS_STORAGE_PATH=/var/lib/micf/results
